# Copia a .env si quieres sobreescribir defaults.
# El servidor solo escucha en local por defecto.

RF_SDR_HOST=127.0.0.1
RF_SDR_PORT=8787

# Serial del dongle (rtl_test / CubicSDR). Vacío = primer dispositivo.
RF_SDR_SERIAL=

# auto o ganancia en dB (p. ej. 28.0). Manual es más estable al barrer.
RF_SDR_GAIN=28.0

# 1 = forzar espectro de prueba aunque haya dongle
RF_SDR_MOCK=0

# 2.048e6 es más estable que 2.4e6 en muchos RTL
RF_SDR_SAMPLE_RATE=2048000
